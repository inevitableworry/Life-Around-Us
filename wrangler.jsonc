{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-around-us-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./web/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/assets/earth/night8k.r8"]
  }
}
